{
  "name": "@e18e/cli",
  "version": "0.0.1",
  "description": "The official e18e CLI",
  "keywords": [
    "dependencies",
    "dependency",
    "e18e",
    "publint"
  ],
  "homepage": "https://github.com/e18e/cli#readme",
  "bugs": {
    "url": "https://github.com/e18e/cli/issues"
  },
  "license": "MIT",
  "author": "e18e Authors (https://e18e.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e18e/cli.git"
  },
  "bin": {
    "e18e-cli": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "cli": "node ./dist/cli.mjs",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test",
    "generate-fixable-replacements": "node scripts/generate-fixable-replacements.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "@e18e/web-features-codemods": "^0.3.0",
    "core-js-compat": "^3.51.0",
    "enginematch": "^0.2.0",
    "fast-wrap-ansi": "^0.2.2",
    "fdir": "^6.5.0",
    "gunshi": "^0.37.3",
    "lockparse": "^0.5.2",
    "module-replacements": "^3.4.0",
    "module-replacements-codemods": "^2.0.1",
    "obug": "^3.0.0",
    "publint": "^0.3.25",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pkg-pr-new": "^0.0.91",
    "tsdown": "^0.23.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
